{
  "name": "easysub",
  "version": "1.0.0",
  "description": "免费、安全的基于本地模型的实时字幕浏览器扩展",
  "license": "AGPL-3.0-or-later",
  "author": "hcz1017",
  "repository": {
    "type": "git",
    "url": "https://github.com/easysub-org/easysub.git"
  },
  "homepage": "https://github.com/easysub-org/easysub",
  "scripts": {
    "download-wasm": "pwsh -ExecutionPolicy Bypass -File scripts/download-wasm.ps1",
    "download-wasm:sh": "bash scripts/download-wasm.sh",
    "build": "webpack --mode production",
    "build:web": "webpack --mode production --env target=web",
    "dev": "webpack --mode development --watch",
    "dev:web": "webpack --mode development --watch --env target=web",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "serve:web": "node scripts/serve-web.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "onnxruntime-web": "1.21.0"
  },
  "overrides": {
    "onnxruntime-web": "1.21.0"
  },
  "engines": {
    "node": ">=18.12"
  }
}
